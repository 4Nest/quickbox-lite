#!/bin/bash
#
# QuickBox nginx auth snippet helper
#
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

MODE="${1:-}"
HTPASSWD_PATH="${2:-}"
INDENT="${3:-  }"

case "$MODE" in
  plain|proxy|fastcgi|console|console-proxy)
    ;;
  *)
    echo "Usage: qbNginxAuth <plain|proxy|fastcgi|console|console-proxy> <htpasswd-path> [indent]" >&2
    exit 1
    ;;
esac

if [[ "$MODE" == "console" || "$MODE" == "console-proxy" ]]; then
  printf '%sauth_request /quickbox/authz;\n' "$INDENT"
  printf '%serror_page 401 = /login;\n' "$INDENT"
  if [[ "$MODE" == "console-proxy" ]]; then
    printf '%sproxy_set_header X-Forwarded-User "";\n' "$INDENT"
  fi
else
  printf '%sauth_basic "Password Required";\n' "$INDENT"
  printf '%sauth_basic_user_file %s;\n' "$INDENT" "$HTPASSWD_PATH"
fi
