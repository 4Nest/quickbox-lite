# The React shell and login API are public; data and file APIs require a session.
location = /quickbox/authz {
    internal;
    proxy_pass http://127.0.0.1:8575/console/api/auth/validate;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $host;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header X-Forwarded-User "";
}

location ^~ /console-assets/ {
    alias /srv/dashboard/console-dist/;
    autoindex off;
}

location = /login {
    proxy_pass http://127.0.0.1:8575;
    include snippets/proxy.conf;
    proxy_set_header X-Forwarded-User "";
}

location ^~ /console/api/auth/ {
    proxy_pass http://127.0.0.1:8575;
    include snippets/proxy.conf;
    proxy_set_header X-Forwarded-User "";
}

if ($request_method = POST) {
  set $no_cache 1;
}

if ($query_string != "") {
  set $no_cache 1;
}

location ^~ /legacy { return 404; }

# Terminal HTTP and WebSocket authentication is enforced by the Node proxy.
location ^~ /terminal/session/ {
    proxy_pass http://127.0.0.1:8575;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
}

location ^~ /db/ {
    return 404;
}

location ^~ /db/master.txt {
    return 404;
}

location ^~ /db/interface.txt {
    return 404;
}

location ^~ /ws {
    satisfy any;
    allow 127.0.0.1;
    deny all;
    auth_basic "password Required";
    auth_basic_user_file /etc/htpasswd;

    proxy_pass http://127.0.0.1:8575;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    include snippets/proxy.conf;
}

location / {
    satisfy any;
    allow 127.0.0.1;
    deny all;
    auth_basic "password Required";
    auth_basic_user_file /etc/htpasswd;

    proxy_pass http://127.0.0.1:8575;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    include snippets/proxy.conf;
}
